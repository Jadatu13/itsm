# ── Docker / production ───────────────────────────────────────────────────
# Port the app will be available on (http://<your-server>:APP_PORT)
# Coolify users: leave APP_PORT unset — Coolify routes via its own Traefik proxy.
APP_PORT=8080

# Full URL of your deployment (used for SSO redirects and magic-link emails)
APP_URL=https://itsm.example.com

# PostgreSQL password (used by both the postgres container and the API)
POSTGRES_PASSWORD=changeme

# CORS allowed origin — must match APP_URL exactly in production (avoid *)
CLIENT_URL=https://itsm.example.com

# ── JWT signing secret (REQUIRED) ────────────────────────────────────────
# The API refuses to start in production without this. Keep it secret; rotating
# it invalidates all existing sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_96_char_hex_string

# ── Encryption key (REQUIRED) ────────────────────────────────────────────
# Encrypts sensitive settings (SMTP/IMAP/AI/M365 secrets) stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string

# ── Microsoft Entra ID SSO (optional — enables "Sign in with Microsoft") ──
# Create an App Registration in Azure Portal → Entra ID → App registrations
# Redirect URI: https://itsm.example.com/api/auth/microsoft/callback
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Email / SMTP (optional — configure via the Settings page in the app) ──
# If SMTP_HOST is not set, emails are silently skipped.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=ITSM Support <notifications@example.com>

# ── Local dev (server/.env only) ─────────────────────────────────────────
# DATABASE_URL=postgres://postgres:password@localhost:5432/itsm
# PORT=3001
# CLIENT_URL=http://localhost:5173
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=ITSM Support <notifications@example.com>
